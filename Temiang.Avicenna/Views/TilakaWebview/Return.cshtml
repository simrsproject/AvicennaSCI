@model Temiang.Avicenna.Common.Tilaka.TilakaWebviewReturnResult
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tilaka</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; background: #f5f6f8; margin: 0; padding: 40px 16px; }
        .box { max-width: 560px; margin: 0 auto; background: #fff; border-radius: 8px; padding: 28px 32px;
               box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08); }
        h3 { margin: 0 0 16px; font-size: 20px; color: #1f2d3d; }
        p { margin: 0 0 16px; line-height: 1.5; color: #2f3e4f; }
        p.ok { color: #1e7e34; }
        p.warn { color: #a0522d; }
        a { color: #1b6ec2; }
    </style>
</head>
<body>
    <div class="box">
        <h3>Tilaka</h3>
        <p class="@(Model != null && Model.IsSuccess ? "ok" : "warn")">@(Model == null ? "Tidak ada hasil." : Model.Message)</p>
        <p><a href="javascript:window.close();">Tutup halaman ini</a></p>
    </div>
</body>
</html>
